# Production Defaults
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/interviu_ai
CLIENT_URL=https://your-frontend-domain
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=30d

# Email Provider Configuration (SMTP)
# If missing, development mode logs email tokens to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=noreply@interviu.ai
GEMINI_API_KEY=your_gemini_api_key_here
