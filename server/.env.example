# Production Defaults
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/interviu_ai
CLIENT_URL=https://your-frontend-domain
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=30d

# Email Provider Configuration (Resend API)
# If missing, development mode logs email tokens to the console.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=Interviu AI <noreply@interviu.ai>
GEMINI_API_KEY=your_gemini_api_key_here
