# =============================================================
# Interview AI — Backend Environment Variables
# Copy this file to server/.env for local development.
# Set all variables in your Render/Railway dashboard for production.
# NEVER commit real values to git.
# =============================================================

# --- Server ---
PORT=5001
NODE_ENV=development

# --- MongoDB ---
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/interviu_ai

# --- JWT (legacy fallback, primary auth is Firebase) ---
JWT_SECRET=your_jwt_secret_here_minimum_32_chars
JWT_EXPIRES_IN=30d

# --- Firebase Admin SDK ---
# Download service account JSON from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Google Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Razorpay (Payment Gateway) ---
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- Brevo (Email / SMTP) ---
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_EMAIL=noreply@yourdomain.com
BREVO_FROM_NAME=Interview AI

# --- CORS — set to the deployed Vercel frontend URL ---
CLIENT_URL=https://interview-ai-two-gamma.vercel.app
